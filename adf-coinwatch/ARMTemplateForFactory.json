{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-coinwatch"
		},
		"ls_adls_coinwatch_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://coinwatchsa.dfs.core.windows.net/"
		},
		"ls_http_binance_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://data.binance.vision"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_backfill_coinwatch_days')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ForEachDay",
						"type": "ForEach",
						"dependsOn": [],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@range(1, pipeline().parameters.days_back)",
								"type": "Expression"
							},
							"isSequential": true,
							"activities": [
								{
									"name": "RunDailyCoinwatchPipeline",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "pl_load_binance_klines_bronze",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"run_date": {
												"value": "@formatDateTime(\n    addDays(utcNow(), mul(item(), -1)),\n    'yyyy-MM-dd'\n)",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"days_back": {
						"type": "int",
						"defaultValue": 60
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/pl_load_binance_klines_bronze')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/pl_load_binance_klines_bronze')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LookupConfig",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "DelimitedTextSource",
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							},
							"dataset": {
								"referenceName": "ds_config_coinwatch_symbols",
								"type": "DatasetReference",
								"parameters": {}
							},
							"firstRowOnly": false
						}
					},
					{
						"name": "ForEachSymbol",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "LookupConfig",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('LookupConfig').output.value",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "CopyBinanceToBronze",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "BinarySource",
											"storeSettings": {
												"type": "HttpReadSettings",
												"requestMethod": "GET"
											},
											"formatSettings": {
												"type": "BinaryReadSettings",
												"compressionProperties": {
													"type": "ZipDeflateReadSettings"
												}
											}
										},
										"sink": {
											"type": "BinarySink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											}
										},
										"enableStaging": false
									},
									"inputs": [
										{
											"referenceName": "ds_binance_zip",
											"type": "DatasetReference",
											"parameters": {
												"symbol": "@item().symbol",
												"interval": "@item().interval",
												"date": "@pipeline().parameters.run_date"
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_adls_bronze_binance_binary",
											"type": "DatasetReference",
											"parameters": {
												"symbol": "@item().symbol",
												"interval": "@item().interval",
												"date": "@pipeline().parameters.run_date"
											}
										}
									]
								}
							]
						}
					},
					{
						"name": "RunCoinwatchDatabricksJobJob1",
						"type": "DatabricksJob",
						"dependsOn": [
							{
								"activity": "ForEachSymbol",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"jobId": "990663311610520",
							"jobParameters": {
								"run_date": {
									"value": "@pipeline().parameters.run_date",
									"type": "Expression"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "ls_databricks_coinwatch",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"run_date": {
						"type": "string"
					}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_config_coinwatch_symbols')]",
				"[concat(variables('factoryId'), '/linkedServices/ls_databricks_coinwatch')]",
				"[concat(variables('factoryId'), '/datasets/ds_binance_zip')]",
				"[concat(variables('factoryId'), '/datasets/ds_adls_bronze_binance_binary')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_adls_bronze_binance_binary')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls_coinwatch",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"symbol": {
						"type": "string"
					},
					"interval": {
						"type": "string"
					},
					"date": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Binary",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat(dataset().symbol, '-', dataset().interval, '-', dataset().date, '.csv')",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat('binance/klines/symbol=', dataset().symbol, '/date=', dataset().date)",
							"type": "Expression"
						},
						"fileSystem": "bronze"
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls_coinwatch')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_binance_zip')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_http_binance",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"symbol": {
						"type": "string"
					},
					"interval": {
						"type": "string"
					},
					"date": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Binary",
				"typeProperties": {
					"location": {
						"type": "HttpServerLocation",
						"relativeUrl": {
							"value": "@concat('data/spot/daily/klines/', dataset().symbol, '/', dataset().interval, '/', dataset().symbol, '-', dataset().interval, '-', dataset().date, '.zip')",
							"type": "Expression"
						}
					}
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_http_binance')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ds_config_coinwatch_symbols')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "ls_adls_coinwatch",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "coinwatch_symbols_config.csv",
						"folderPath": "config",
						"fileSystem": "bronze"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "symbol",
						"type": "String"
					},
					{
						"name": "interval",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_adls_coinwatch')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_adls_coinwatch')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('ls_adls_coinwatch_properties_typeProperties_url')]",
					"authenticate as": "System Assigned Managed Identity (no encryptedCredential)"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_databricks_coinwatch')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "https://adb-XXXX.YY.azuredatabricks.net",
					"authentication": "MSI",
					"workspaceResourceId": "/subscriptions/<new-sub>/resourceGroups/rg-coinwatch/providers/Microsoft.Databricks/workspaces/dbw-coinwatch"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_http_binance')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('ls_http_binance_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		}
	]
}